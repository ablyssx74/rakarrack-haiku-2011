SUMMARY="A richly featured multi-effects processor for guitar"
DESCRIPTION="Rakarrack emulates a guitar effects pedalboard. Effects include \
compressor, expander, noise gate, graphic and parametric equalizers, exciter, \
shuffle, convolotron, valve, flanger, dual flange, chorus, musical delay, \
arpie, echo with reverse playback, reverb, digital and analogic phasers, \
synthfilter, varyband, ring, wah-wah, alien-wah, mutromojo, harmonizer, \
infinity, looper and four flexible distortion modules including sub-octave \
modulation and dirty octave up. Most of the effects engine is built from \
modules found in the ZynAddSubFX software synthesizer.

This is the Haiku port of Rakarrack 0.6.2. It uses the Haiku Media Kit for \
audio and the MIDI2 Kit for MIDI instead of JACK and ALSA."
HOMEPAGE="https://github.com/ablyssx74/rakarrack-haiku-2011"
COPYRIGHT="2008-2011 Josep Andreu, Ryan Billing and others
	2026 ablyss (Haiku port)"
LICENSE="GNU GPL v2"
REVISION="2"
# Source is the GitHub tag v<version>-<revision>. GitHub strips the leading
# "v" from the directory name inside the tarball, hence SOURCE_DIR below.
# CHECKSUM_SHA256 is the sha256sum of that tag's tarball -- a new tag needs a
# new checksum.
SOURCE_URI="https://github.com/ablyssx74/rakarrack-haiku-2011/archive/refs/tags/v$portVersion-$REVISION.tar.gz"
CHECKSUM_SHA256="<sha256 of the v0.6.2-2 tag tarball>"
SOURCE_DIR="rakarrack-haiku-2011-$portVersion-$REVISION"

# GCC13 only. On a 32-bit hybrid (x86_gcc2h) the primary x86_gcc2 build is not
# possible, so the app is built there as the secondary-architecture package
# rakarrack_x86 (haikuporter rakarrack_x86; needs
# SECONDARY_TARGET_ARCHITECTURES="x86" in haikuports.conf). On 64-bit it is the
# plain rakarrack package. Don't use "all" here: with "all", haikuporter gives
# the secondary architecture the primary one's status, which would exclude it.
ARCHITECTURES="x86_64 ?x86"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	rakarrack$secondaryArchSuffix = $portVersion
	app:Rakarrack$secondaryArchSuffix = $portVersion
	cmd:rakarrack$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libfftw3$secondaryArchSuffix
	lib:libfltk$secondaryArchSuffix
	lib:libcurl$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libsamplerate$secondaryArchSuffix
	lib:libsndfile$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libfftw3$secondaryArchSuffix
	devel:libfltk$secondaryArchSuffix
	devel:libfontconfig$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libcurl$secondaryArchSuffix
	devel:libsamplerate$secondaryArchSuffix
	devel:libsndfile$secondaryArchSuffix
	devel:libXpm$secondaryArchSuffix
	devel:libXfont2$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:aclocal
	cmd:autoconf
	cmd:automake
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	# haiku.makefile drives configure + the (non-automake) link, and embeds
	# the app resources (rakarrack.rdef) into the binary. It picks the 32-bit
	# toolchain/library paths itself when run on a 32-bit Haiku.
	make -f haiku.makefile config build
}

INSTALL()
{
	# These must match the --datadir/--docdir compiled in by `config`
	# in haiku.makefile (/boot/system/data/rakarrack/share/...); the app
	# also looks them up at runtime from wherever its package is installed.
	share=$dataDir/rakarrack/share

	mkdir -p $appsDir $binDir $manDir/man1
	mkdir -p $share/rakarrack $share/doc/rakarrack

	cp rakarrack $appsDir/Rakarrack
	# bin is bin/ on the primary architecture but bin/x86/ for a secondary
	# one, so compute the link target instead of hard-coding ../apps.
	ln -s "$(realpath --relative-to=$binDir $appsDir)/Rakarrack" $binDir/rakarrack
	addAppDeskbarSymlink $appsDir/Rakarrack Rakarrack

	cp data/*.{rvb,dly,rkrb,wav} $share/rakarrack
	cp -r doc/help $share/doc/rakarrack/html
	cp AUTHORS COPYING ChangeLog NEWS $share/doc/rakarrack
	cp man/rakarrack.1 $manDir/man1
}
